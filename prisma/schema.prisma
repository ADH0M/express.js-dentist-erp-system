// Dentist ERP System — Prisma schema
// Docs: docs/execution-plan/01-database-and-prisma-setup.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  SUPER_ADMIN
  DENTIST
  RECEPTIONIST
}

enum StaffPosition {
  DENTIST
  HYGIENIST
  RECEPTIONIST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
}

enum RecordCategory {
  MEDICAL
  DENTAL
}

// ---------- Staff / HR ----------

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  passwordHash  String
  fullName      String
  role          UserRole      @default(RECEPTIONIST)
  position      StaffPosition @default(RECEPTIONIST)
  phone         String?
  licenseNumber String? // dentists/hygienists
  bio           String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  schedules            StaffSchedule[]
  timeOffEntries       TimeOffEntry[]
  appointments         Appointment[]        @relation("AppointmentDentist")
  createdAppointments  Appointment[]        @relation("AppointmentCreator")
  recordedPayments     Payment[]
  patientsCreated      Patient[]            @relation("PatientCreator")
  invoicesCreated      Invoice[]
  createdHistories     MedicalRecordEntry[] @relation("HistoryCreator")

  @@index([role, isActive])
  @@index([position, isActive])
}

model StaffSchedule {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime String // "HH:mm" local clinic time
  endTime   String // "HH:mm"
  breaks    Json? // [{ "start": "13:00", "end": "14:00" }]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

model TimeOffEntry {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  startsAt DateTime @db.Timestamptz
  endsAt   DateTime @db.Timestamptz
  reason   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt, endsAt])
}

// ---------- Patients ----------

model Patient {
  id                String  @id @default(uuid()) @db.Uuid
  firstName         String
  lastName          String
  dateOfBirth       DateTime @db.Date
  gender            String // MALE | FEMALE | OTHER (validated in Zod)
  email             String? @unique
  phone             String
  address           String?
  emergencyContact  Json? // { name, phone, relation }
  insuranceProvider String?
  insurancePolicyNo String?
  allergies         String? // free text summary
  chronicConditions String? // free text summary
  notes             String?
  isDeleted         Boolean @default(false)
  createdById       String  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy    User                 @relation("PatientCreator", fields: [createdById], references: [id])
  history      MedicalRecordEntry[]
  appointments Appointment[]
  invoices     Invoice[]

  @@index([lastName, firstName])
  @@index([isDeleted])
  @@index([phone])
}

model MedicalRecordEntry {
  id           String         @id @default(uuid()) @db.Uuid
  patientId    String         @db.Uuid
  category     RecordCategory
  title        String // e.g. "Root canal on 36", "Penicillin allergy"
  description  String
  recordDate   DateTime       @db.Timestamptz
  recordedById String         @db.Uuid
  createdAt    DateTime       @default(now())

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("HistoryCreator", fields: [recordedById], references: [id])

  @@index([patientId, category])
  @@index([patientId, recordDate])
}

// ---------- Treatments catalog ----------

model Treatment {
  id              String  @id @default(uuid()) @db.Uuid
  code            String  @unique // "CLEAN-01"
  name            String
  description     String?
  defaultPrice    Decimal @db.Decimal(12, 2)
  durationMinutes Int
  isActive        Boolean @default(true)

  appointments Appointment[]
  invoiceItems InvoiceItem[]

  @@index([isActive])
}

// ---------- Appointments ----------

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  patientId       String            @db.Uuid
  dentistId       String            @db.Uuid
  treatmentId     String?           @db.Uuid
  scheduledAt     DateTime          @db.Timestamptz
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  cancelReason    String?
  createdById     String            @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id])
  dentist   User       @relation("AppointmentDentist", fields: [dentistId], references: [id])
  treatment Treatment? @relation(fields: [treatmentId], references: [id])
  createdBy User       @relation("AppointmentCreator", fields: [createdById], references: [id])
  invoice   Invoice?

  @@index([dentistId, scheduledAt, status])
  @@index([patientId, scheduledAt])
  @@index([status])
}

// ---------- Billing ----------

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique // INV-2026-000001
  patientId     String        @db.Uuid
  appointmentId String?       @unique @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  dueDate       DateTime      @db.Date
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @db.Decimal(5, 4)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  createdById   String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient     Patient       @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  createdBy   User          @relation(fields: [createdById], references: [id])

  @@index([patientId])
  @@index([status, issuedAt])
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  treatmentId String? @db.Uuid
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatment Treatment? @relation(fields: [treatmentId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceId    String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String        @db.Uuid

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}
